# Copia este archivo a .env.production y reemplaza cada valor marcado con
# CAMBIAR_ESTO antes de levantar los contenedores. NUNCA subas .env.production
# a git (ya está protegido en .gitignore, pero revisa antes de hacer commit).

# --- Dirección del sitio dentro de la red de la oficina ---
# El subdominio interno real (si sistemas tiene DNS interno), o si no, un
# nombre inventado agregado al archivo hosts de cada computador de la
# oficina (ej. CADDY_DOMAIN=iurisync.local, CORS_ORIGINS=https://iurisync.local)
# — ver la guía de despliegue, sección 1. NO pongas aquí la IP directamente:
# varias versiones de Windows fallan al conectarse por HTTPS a una IP sin
# nombre (ERR_SSL_PROTOCOL_ERROR).
CADDY_DOMAIN=documentos.avancejuridico.com.co
CORS_ORIGINS=https://documentos.avancejuridico.com.co

# --- Base de datos ---
POSTGRES_USER=iurisync
POSTGRES_PASSWORD=CAMBIAR_ESTO_password_seguro
POSTGRES_DB=iurisync
# El usuario y password aquí deben coincidir exactamente con POSTGRES_USER/POSTGRES_PASSWORD de arriba.
DATABASE_URL=postgresql+psycopg://iurisync:CAMBIAR_ESTO_password_seguro@postgres:5432/iurisync

# --- Cola de tareas en segundo plano ---
REDIS_URL=redis://redis:6379/0

# --- Almacenamiento de documentos (MinIO propio del proyecto, temporal) ---
# Dirección interna: la usa el servidor para guardar y leer archivos. El nombre
# "minio" solo existe dentro de Docker, así que esta línea se deja tal cual.
S3_ENDPOINT_URL=http://minio:9000
# Dónde vive físicamente la carpeta de documentos en el servidor. Por defecto
# (si dejas esta línea comentada) Docker la guarda en un volumen interno,
# no visible como una carpeta normal en el disco. Si sistemas asignó un disco
# o ruta específica para centralizar los documentos, descomenta la línea y
# pon esa ruta (ej. MINIO_DATA_PATH=O:\IURISYNC en Windows, o
# MINIO_DATA_PATH=/mnt/iurisync-data en Linux). Ver la guía de despliegue,
# sección 7, "Cambiar dónde se guardan los documentos" — si ya hay documentos
# guardados, hay que migrarlos con esos pasos, no basta con cambiar esta línea.
# MINIO_DATA_PATH=O:\IURISYNC
# Dirección pública: la usa el NAVEGADOR de cada persona al abrir o descargar un
# documento. Tiene que ser la misma dirección de CADDY_DOMAIN, con el puerto
# 9443 (que Caddy publica hacia la red de la oficina). Si esta
# línea falta, los enlaces de descarga apuntarían a http://minio:9000, un
# nombre que solo existe dentro del servidor, y ningún documento se podría
# abrir desde un computador de la oficina.
S3_PUBLIC_ENDPOINT_URL=https://documentos.avancejuridico.com.co:9443
S3_ACCESS_KEY=CAMBIAR_ESTO_usuario_minio
S3_SECRET_KEY=CAMBIAR_ESTO_password_minio_largo_y_unico
S3_BUCKET=iurisync-documents
S3_REGION=us-east-1

# --- Registro de usuarios ---
# Código que cada persona debe ingresar para crear su cuenta la primera vez.
REGISTRATION_CODE=CAMBIAR_ESTO_codigo_de_invitacion

# --- Búsqueda de documentos nuevos ---
# Cuántos días hacia atrás revisa cada fuente en la corrida automática diaria.
# No es obligatorio definirlo (por defecto 3); solo cámbialo si el equipo de
# desarrollo te lo indica.
SCHEDULED_RUN_LOOKBACK_DAYS=3
